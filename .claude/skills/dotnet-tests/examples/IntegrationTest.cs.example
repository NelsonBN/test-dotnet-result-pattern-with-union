// Example only (not compiled): a narrow integration test with a real PostgreSQL (Testcontainers)
// behind the in-process API (WebApplicationFactory), asserted with Assertions.Web.
using System.Net.Http.Json;
using AwesomeAssertions;
using Microsoft.AspNetCore.Mvc.Testing;
using Microsoft.Extensions.DependencyInjection;
using Testcontainers.PostgreSql;
using Xunit;

namespace Orders.IntegrationTests;

public sealed class OrdersApiFactory : WebApplicationFactory<Program>, IAsyncLifetime
{
    private readonly PostgreSqlContainer _database = new PostgreSqlBuilder()
        .WithImage("postgres:16.4") // pinned tag, never latest
        .Build();

    public async ValueTask InitializeAsync() => await _database.StartAsync();

    public override async ValueTask DisposeAsync()
    {
        await _database.DisposeAsync();
        await base.DisposeAsync();
    }

    protected override void ConfigureWebHost(IWebHostBuilder builder)
    {
        builder.ConfigureTestServices(services =>
        {
            services.RemoveAll<DbContextOptions<OrdersDbContext>>();
            services.AddDbContext<OrdersDbContext>(o => o.UseNpgsql(_database.GetConnectionString()));
        });
    }
}

[Trait("Category", "Integration")]
public sealed class OrdersEndpointTests(OrdersApiFactory factory) : IClassFixture<OrdersApiFactory>
{
    private readonly HttpClient _client = factory.CreateClient();

    [Fact]
    public async Task Given_ValidOrder_When_Post_Then_Returns201AndOrderIsPersisted()
    {
        // Arrange
        var request = new CreateOrder(CustomerId: Guid.NewGuid(), Sku: "SKU-1", Quantity: 2);

        // Act
        var response = await _client.PostAsJsonAsync("/orders", request, TestContext.Current.CancellationToken);

        // Assert
        response.Should().Be201Created().And.HaveHeader("Location");
        var created = await response.Content.ReadFromJsonAsync<OrderDto>(TestContext.Current.CancellationToken);
        var stored = await _client.GetAsync($"/orders/{created!.Id}", TestContext.Current.CancellationToken);
        stored.Should().Be200Ok().And.BeAs(new { created.Id, Quantity = 2 });
    }

    [Fact]
    public async Task Given_ZeroQuantity_When_Post_Then_Returns400ProblemDetails()
    {
        // Arrange
        var request = new CreateOrder(Guid.NewGuid(), "SKU-1", 0);

        // Act
        var response = await _client.PostAsJsonAsync("/orders", request, TestContext.Current.CancellationToken);

        // Assert
        response.Should().Be400BadRequest();
    }
}
