// Example only (not compiled): unit tests in the dotnet-tests pattern.
// Path: tests/Payments.Tests/PaymentServiceTests.cs  (mirrors src/Payments/PaymentService.cs)
// Subject: a PaymentService that charges through an IPaymentGateway and records through an IAuditLog.
// No `using Xunit/AwesomeAssertions/NSubstitute`: the test csproj adds them implicitly (<Using Include="..." />).

namespace Payments.Tests;

public sealed class PaymentServiceTests
{
    private readonly IPaymentGateway _gateway = Substitute.For<IPaymentGateway>(); // stub + mock boundary
    private readonly IAuditLog _audit = Substitute.For<IAuditLog>();               // spy
    private readonly PaymentService _sut;

    public PaymentServiceTests()
    {
        _sut = new PaymentService(_gateway, _audit);
    }

    [Fact]
    public async Task Given_ApprovedCharge_When_Pay_Then_ReturnsReceiptWithAmount()
    {
        // Arrange
        _gateway.ChargeAsync("card-1", 25m, Arg.Any<CancellationToken>()).Returns(new ChargeResult(true, "tx-9"));

        // Act
        var receipt = await _sut.PayAsync("card-1", 25m, TestContext.Current.CancellationToken);

        // Assert
        receipt.TransactionId.Should().Be("tx-9");
        receipt.Amount.Should().Be(25m);
    }

    [Fact]
    public async Task Given_DeclinedCharge_When_Pay_Then_ThrowsAndWritesNoAuditEntry()
    {
        // Arrange
        _gateway.ChargeAsync("card-1", 25m, Arg.Any<CancellationToken>()).Returns(new ChargeResult(false, null));

        // Act
        var act = () => _sut.PayAsync("card-1", 25m, TestContext.Current.CancellationToken);

        // Assert
        await act.Should().ThrowAsync<PaymentDeclinedException>();
        _audit.DidNotReceive().Record(Arg.Any<string>());
    }

    [Theory]
    [InlineData(0)]
    [InlineData(-1)]
    public async Task Given_NonPositiveAmount_When_Pay_Then_ThrowsArgumentOutOfRange(decimal amount)
    {
        // Act
        var act = () => _sut.PayAsync("card-1", amount, TestContext.Current.CancellationToken);

        // Assert
        (await act.Should().ThrowAsync<ArgumentOutOfRangeException>()).WithParameterName("amount");
    }

    [Fact]
    public async Task Given_ApprovedCharge_When_Pay_Then_RecordsAuditEntryOnce()
    {
        // Arrange
        _gateway.ChargeAsync("card-1", 25m, Arg.Any<CancellationToken>()).Returns(new ChargeResult(true, "tx-9"));

        // Act
        await _sut.PayAsync("card-1", 25m, TestContext.Current.CancellationToken);

        // Assert: the audit entry is part of the contract, so the interaction is verified with the exact argument
        _audit.Received(1).Record(Arg.Is<string>(entry => entry.Contains("tx-9")));
    }
}
